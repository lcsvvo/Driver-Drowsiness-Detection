# =============================================================
# 원칙: 코드 · 문서 · 학습된 가중치만 추적한다.
#      데이터셋 이미지와 원본 영상은 추적하지 않는다.
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---------- 가상환경 ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 비밀값 ----------
.env
.env.*
!.env.example

# =============================================================
# 데이터 / 결과물
#  - 용량: 영상 데이터셋은 GB 단위 (GitHub 파일당 100MB 제한)
#  - 라이선스: DMD 등 일부 데이터셋은 재배포 제한이 있다
#  - 초상권: 직접 촬영한 얼굴 영상이 포함된다
# =============================================================
data/
outputs/
private/

# 영상 파일 (경로 무관 전면 차단)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# 대용량 포맷
*.zip
*.tar
*.tar.gz
*.7z
*.npy
*.npz
*.log

# =============================================================
# 모델 / 가중치
#
# 학습된 .keras 는 저장소에 넣지 않고 **Release 로 배포한다**
# (태그 weights-260820). 저장소가 무거워지지 않고, 가중치를 갱신해도
# 코드 히스토리가 지저분해지지 않는다.
#
# 평가 지표(_metrics.json)는 추적한다. 전부 합쳐 40KB 이고,
# 어떤 조건이 왜 뽑혔는지의 근거이자 노트북이 입력 규격을 읽는 파일이다.
# =============================================================
*.keras
*.pt
*.pth
*.h5
*.tflite
*.task
*.dat
*.caffemodel
*.weights

# onnx 는 원칙적으로 막되, YuNet 검출기만 예외로 둔다 (227KB).
# 우리가 학습한 것이 아니라 받아서 쓰는 사전학습 모델이고,
# 이게 없으면 02_INFER_YuNet.ipynb 이 아예 돌지 않는다.
*.onnx
!model/detectors/face_detection_yunet_2023mar.onnx
