# =============================================================
# Driver Drowsiness & Distraction Detection - .gitignore
# 원칙: 코드와 문서만 추적한다.
#      데이터 / 모델 / 영상 / 실행 결과는 추적하지 않는다.
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.pytest_cache/
*.egg-info/
build/
dist/

# ---------- 가상환경 ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- IDE ----------
.vscode/
.idea/
*.swp

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 로컬 환경 변수 ----------
# API Key / 비밀번호 등은 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# =============================================================
# 데이터 / 모델 / 결과물
#  - 용량: 영상 데이터셋은 GB 단위 (GitHub 파일당 100MB 제한)
#  - 라이선스: 일부 공개 데이터셋은 재배포 제한
#  - 개인정보: 팀원 얼굴이 촬영된 영상 포함 (초상권)
# 폴더 단위 + 확장자 단위로 이중 차단한다.
# =============================================================

# ---------- 민감/비공개 자료 ----------
# 회의록, 팀원 연락처·일정, 개인 실험 메모 등.
# 폴더는 미리 만들지 않는다. 필요해질 때 만들면 이 규칙이 바로 적용된다.
private/

# ---------- 데이터 ----------
data/

# ---------- 실행 결과 (로그, 캡처, 데모 영상) ----------
outputs/

# ---------- 영상 파일 (경로 무관 전면 차단) ----------
# 얼굴이 담긴 촬영본이 실수로 루트에 놓여도 막기 위함
*.mp4
*.avi
*.mov
*.mkv
*.webm

# ---------- 모델 / 가중치 ----------
# 현재 MediaPipe 내장 모델만 사용하지만, 추후 대비해 미리 차단
models/
*.pt
*.pth
*.onnx
*.h5
*.tflite
*.task
*.dat
*.caffemodel
*.weights

# ---------- 대용량 데이터 포맷 ----------
*.zip
*.tar
*.tar.gz
*.7z
*.npy
*.npz

# ---------- 로그 ----------
*.log

# =============================================================
# 주의: 이미지 확장자(*.png, *.jpg)는 전면 차단하지 않는다.
#      README에 넣을 스크린샷·다이어그램까지 함께 제외되기 때문.
#      데이터셋 이미지는 위의 data/ 규칙으로 이미 제외된다.
# =============================================================
